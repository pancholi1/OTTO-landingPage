    <!-- ===== IntersectionObserver: animar al hacer scroll ===== -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );

      document.querySelectorAll('.fade-up, .fade-in').forEach((el) => {
        observer.observe(el);
      });

      // Hero elements entran al cargar (no necesitan scroll)
      document.querySelectorAll('section:first-of-type .fade-up, section:first-of-type .fade-in').forEach((el) => {
        setTimeout(() => el.classList.add('visible'), 100);
      });

      // Navbar pill: se contrae y opaca al hacer scroll
      const header = document.getElementById('site-header');
      const pill = document.getElementById('nav-pill');
      if (header && pill) {
        const onScroll = () => {
          if (window.scrollY > 8) {
            header.classList.remove('pt-4', 'sm:pt-6');
            header.classList.add('pt-3');
            pill.classList.add('bg-white/95', 'shadow-[0_24px_50px_-26px_rgba(30,58,138,0.5)]');
            pill.classList.remove('shadow-[0_18px_40px_-24px_rgba(30,58,138,0.35)]');
          } else {
            header.classList.add('pt-4', 'sm:pt-6');
            header.classList.remove('pt-3');
            pill.classList.remove('bg-white/95', 'shadow-[0_24px_50px_-26px_rgba(30,58,138,0.5)]');
            pill.classList.add('shadow-[0_18px_40px_-24px_rgba(30,58,138,0.35)]');
          }
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      // Cerrar otras FAQ al abrir una (comportamiento acordeón)
      const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('.faq-item'));
      faqItems.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (item.open) {
            faqItems.forEach((other) => { if (other !== item) other.open = false; });
          }
        });
      });
    </script>

