---
import '../styles/global.css';
import '@fontsource-variable/inter';

// CTA endpoints — únicos destinos de acción en toda la página
const APP_STORE = "https://apps.apple.com/ar/app/id6798819331";
const WA = "https://wa.me/5493329325672";
const WA_PADRES = "https://wa.me/5493329325672?text=" + encodeURIComponent("Hola, quiero saber más sobre OTTO para mi hijo/a");
const WA_DUDAS = "https://wa.me/5493329325672?text=" + encodeURIComponent("Hola, tengo una duda sobre la app OTTO");
const MAIL = "mailto:contacto@ottoedu.com.ar";
const LOGIN = "https://app.ottoedu.com.ar/login";

// FAQ: fuente única para el render y el JSON-LD (el schema debe espejar el copy visible)
const FAQS = [
  { q: "¿Qué es OTTO exactamente?", a: "Una app de refuerzo escolar para chicos de 1° a 3° grado (6 a 9 años). Practican lectura, escritura, matemática y ciencias jugando, con contenido alineado al Diseño Curricular de la Provincia de Buenos Aires — el mismo que ven en la escuela." },
  { q: "¿Para qué edad es?", a: "Para chicos de primer ciclo de primaria: 1°, 2° y 3° grado (6 a 9 años). Al crear la cuenta elegís el grado y OTTO le muestra actividades de su nivel." },
  { q: "¿Cómo empieza mi hijo a usarla?", a: "Descargás la app, entrás con tu cuenta de Google o Apple (la del adulto) y elegís el grado. Después le toca a tu hijo: elige un huevo, lo ve nacer y le pone nombre a su búho. Desde ahí, a jugar." },
  { q: "¿Cuánto cuesta?", a: "Descargar la app y explorar el contenido es gratis. Para jugar las actividades hay una suscripción que se contrata desde la app: mensual de USD 2,99 o anual de USD 24,99 (te ahorrás alrededor de un 30%). Se cobra a través del App Store y la podés cancelar cuando quieras desde tu cuenta." },
  { q: "¿Tiene publicidad?", a: "No. OTTO no tiene publicidad, ni compras sorpresa pensadas para chicos, ni chats con desconocidos. Las acciones de compra están protegidas con una barrera para adultos." },
  { q: "¿Qué pasa con los datos de mi hijo?", a: "Pedimos lo mínimo indispensable, no vendemos ni compartimos datos con terceros para publicidad, y la cuenta la crea y administra un adulto. Podés leer la política de privacidad completa en esta misma página." },
  { q: "¿Necesita internet para usarla?", a: "Sí, la app necesita conexión para cargar las actividades y guardar el progreso. Funciona con cualquier wifi o datos móviles." },
  { q: "¿Está para Android?", a: "Estamos trabajando para llegar muy pronto a Google Play. Hoy OTTO está disponible en el App Store para iPhone y iPad. Si querés que te avisemos cuando salga en Android, escribinos por WhatsApp." },
  { q: "La escuela de mi hijo ya usa OTTO, ¿pago igual?", a: "No. Si tu hijo tiene OTTO por su escuela, entra con su cuenta escolar y mantiene el acceso completo sin costo extra: sus misiones y su clase siempre están incluidas." },
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "OTTO",
  "url": "https://www.ottoedu.com.ar/",
  "logo": "https://www.ottoedu.com.ar/logoOtto.png",
  "email": "contacto@ottoedu.com.ar",
  "telephone": "+5493329325672",
  "sameAs": ["https://www.instagram.com/ottoeduca/"],
  "description": "App de refuerzo escolar para chicos de 1° a 3° grado. Practican lectura, escritura y matemática jugando, con contenido alineado al Diseño Curricular de la DGCyE.",
  "areaServed": { "@type": "AdministrativeArea", "name": "Argentina" },
  "contactPoint": { "@type": "ContactPoint", "contactType": "customer support", "email": "contacto@ottoedu.com.ar", "telephone": "+5493329325672", "availableLanguage": "es" },
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  "name": "OTTO",
  "operatingSystem": "iOS",
  "applicationCategory": "EducationalApplication",
  "url": APP_STORE,
  "description": "App de refuerzo escolar para chicos de 1° a 3° grado: lectura, escritura, matemática y ciencias, jugando.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQS.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a },
  })),
};
---

<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/pet.png" />
    <link rel="apple-touch-icon" href="/pet.png" />
    <meta name="theme-color" content="#14215c" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>OTTO — La app con la que tus hijos repasan la escuela jugando</title>
    <meta name="description" content="Refuerzo escolar para chicos de 1° a 3° grado: lectura, escritura y matemática jugando, alineado a lo que ven en la escuela. Descargala gratis en el App Store." />
    <link rel="canonical" href="https://www.ottoedu.com.ar/" />
    <!-- Open Graph (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:title" content="OTTO — Tus hijos repasan la escuela jugando" />
    <meta property="og:description" content="App de refuerzo escolar para chicos de 6 a 9 años. Lectura, escritura y matemática jugando, sin publicidad. Descargala gratis en el App Store." />
    <meta property="og:image" content="https://www.ottoedu.com.ar/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OTTO — App de refuerzo escolar para chicos de 1° a 3° grado" />
    <meta property="og:url" content="https://www.ottoedu.com.ar/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="OTTO — Tus hijos repasan la escuela jugando" />
    <meta name="twitter:description" content="App de refuerzo escolar para chicos de 6 a 9 años. Sin publicidad. Descargala gratis en el App Store." />
    <meta name="twitter:image" content="https://www.ottoedu.com.ar/og-image.jpg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <style>
      /* Evita scroll/desborde horizontal en mobile (blobs y formas decorativas) */
      html, body {
        max-width: 100%;
        overflow-x: hidden;
      }

      /* Animaciones de entrada */
      .fade-up {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.55s cubic-bezier(0.16,1,0.3,1), transform 0.55s cubic-bezier(0.16,1,0.3,1);
      }
      .fade-up.visible {
        opacity: 1;
        transform: translateY(0);
      }
      .fade-in {
        opacity: 0;
        transition: opacity 0.7s ease;
      }
      .fade-in.visible {
        opacity: 1;
      }
      /* Delay helpers */
      .delay-1 { transition-delay: 0.08s; }
      .delay-2 { transition-delay: 0.16s; }
      .delay-3 { transition-delay: 0.24s; }
      .delay-4 { transition-delay: 0.32s; }
      .delay-5 { transition-delay: 0.40s; }

      /* Float card */
      @keyframes floatCard {
        0%, 100% { transform: translateY(0px); }
        50%       { transform: translateY(-10px); }
      }
      .float-card {
        animation: floatCard 5s ease-in-out infinite;
      }

      /* Pulse dot */
      @keyframes pulseDot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.4; transform: scale(1.4); }
      }
      .pulse-dot {
        animation: pulseDot 2.2s ease-in-out infinite;
      }

      /* Bounce arrow */
      @keyframes bounceX {
        0%, 100% { transform: translateX(0); }
        50%       { transform: translateX(4px); }
      }
      .bounce-arrow { animation: bounceX 1.6s ease-in-out infinite; }

      /* Hero oscuro — fondo azul profundo con brillos de marca */
      .hero-dark {
        background-color: #14215c;
        background-image:
          radial-gradient(ellipse 60% 70% at 80% 0%, rgba(14,165,233,0.45) 0%, transparent 60%),
          radial-gradient(ellipse 55% 60% at 10% 100%, rgba(14,165,233,0.42) 0%, transparent 60%),
          linear-gradient(160deg, #1E3A8A 0%, #14215c 55%, #0c1640 100%);
      }
      /* Curva blanca inferior que separa el hero del resto */
      .hero-wave {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        width: 100%;
        height: clamp(40px, 6vw, 90px);
        display: block;
        pointer-events: none;
      }
      /* Variante superior: la curva del color claro entra sobre la banda oscura */
      .hero-wave-top {
        position: absolute;
        left: 0;
        right: 0;
        top: -1px;
        width: 100%;
        height: clamp(40px, 6vw, 90px);
        display: block;
        pointer-events: none;
        z-index: 1;
      }
      /* Formas geométricas decorativas flotando */
      @keyframes floatShape {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50%      { transform: translateY(-16px) rotate(8deg); }
      }
      .float-shape { animation: floatShape 9s ease-in-out infinite; }
      .float-shape-slow { animation: floatShape 13s ease-in-out infinite reverse; }

      /* Card glass effect */
      .glass-card {
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      /* Subtle grain for sections */
      .section-alt {
        background-color: #f8faff;
      }

      /* ===== Visual polish toolkit ===== */

      /* Decorative dot grid (hero + dark CTA backdrops) */
      .dot-grid-light {
        background-image: radial-gradient(rgba(255,255,255,0.14) 1px, transparent 1px);
        background-size: 24px 24px;
      }

      /* Gradient text (headlines / brand accents) */
      .text-gradient {
        background: linear-gradient(110deg, #0ea5e9 0%, #0369A1 45%, #1E3A8A 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
      }

      /* Animated shimmer sweep over a surface */
      @keyframes shimmer {
        0%   { transform: translateX(-150%) skewX(-12deg); }
        100% { transform: translateX(250%) skewX(-12deg); }
      }
      .shimmer { position: relative; overflow: hidden; }
      .shimmer::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.28), transparent);
        transform: translateX(-150%) skewX(-12deg);
        pointer-events: none;
      }
      .shimmer:hover::after { animation: shimmer 0.9s ease; }

      /* Gradient border wrapper (1px stroke that picks up brand hues) */
      .gradient-border {
        position: relative;
        background: #fff;
        border-radius: 1rem;
      }
      .gradient-border::before {
        content: '';
        position: absolute;
        inset: 0;
        padding: 1.5px;
        border-radius: inherit;
        background: linear-gradient(135deg, #0ea5e9, #0369A1 55%, #10B981);
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0.55;
        transition: opacity 0.3s ease;
        pointer-events: none;
      }
      .gradient-border:hover::before { opacity: 1; }

      /* Lift + spring on hover, smoother than translate alone */
      .lift {
        transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), box-shadow 0.35s cubic-bezier(0.16,1,0.3,1);
        will-change: transform;
      }
      .lift:hover {
        transform: translateY(-6px);
        box-shadow: 0 24px 48px -22px rgba(30,58,138,0.30);
      }

      /* Slow counter-floating blob (hero decoratives) */
      @keyframes floatBlob {
        0%, 100% { transform: translate(0,0) scale(1); }
        50%      { transform: translate(14px,-22px) scale(1.06); }
      }
      .float-blob { animation: floatBlob 16s ease-in-out infinite; }
      .float-blob-slow { animation: floatBlob 22s ease-in-out infinite reverse; }

      /* Gentle scale-breath for icons / mascots */
      @keyframes breathe {
        0%, 100% { transform: scale(1); }
        50%      { transform: scale(1.07); }
      }
      .breathe { animation: breathe 4s ease-in-out infinite; }

      /* Wobble suave para los búhos avatar */
      @keyframes owlWobble {
        0%, 100% { transform: rotate(0deg) translateY(0); }
        30%      { transform: rotate(-3deg) translateY(-6px); }
        60%      { transform: rotate(2.5deg) translateY(-2px); }
      }
      .owl-wobble { animation: owlWobble 6s ease-in-out infinite; }

      /* Sheen across the primary CTA on hover */
      .btn-primary {
        position: relative;
        overflow: hidden;
        isolation: isolate;
      }
      .btn-primary::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(100deg, transparent 30%, rgba(255,255,255,0.35) 50%, transparent 70%);
        transform: translateX(-120%);
        transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
        z-index: -1;
      }
      .btn-primary:hover::before { transform: translateX(120%); }

      /* ===== Formas geométricas decorativas por sección ===== */
      .shape { position: absolute; pointer-events: none; z-index: 0; opacity: 0.9; }
      .shape-ring { border-radius: 9999px; border-style: solid; background: transparent; }
      .shape-dot  { border-radius: 9999px; }
      .shape-sq   { border-radius: 6px; }
      /* Las secciones con formas deben recortar el overflow y apilar contenido encima */
      .has-shapes { position: relative; overflow: hidden; }
      .has-shapes > .max-w-6xl,
      .has-shapes > .max-w-5xl,
      .has-shapes > .max-w-4xl,
      .has-shapes > .max-w-3xl { position: relative; z-index: 1; }
      @media (max-width: 640px) { .shape { display: none; } }

      /* Eyebrow: punto + pill */
      .eyebrow-dot::before {
        content: '';
        display: inline-block;
        width: 6px; height: 6px;
        border-radius: 9999px;
        background: currentColor;
        margin-right: 7px;
        vertical-align: middle;
      }

      /* FAQ accordion */
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary { outline: none; }
      .faq-item[open] { box-shadow: 0 12px 30px -16px rgba(30,58,138,0.25); border-color: rgba(3,105,161,0.3); }
      .faq-item[open] > p { animation: faqReveal 0.35s ease; }
      @keyframes faqReveal {
        from { opacity: 0; transform: translateY(-4px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      /* Respect reduced-motion preferences */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
        .fade-up, .fade-in { opacity: 1 !important; transform: none !important; }
      }
    </style>
  </head>
  <body class="font-['Inter_Variable',Inter,system-ui,sans-serif] bg-white text-gray-900 antialiased overflow-x-hidden" style="font-feature-settings: 'kern' 1, 'liga' 1;">

    <!-- ===== NAVBAR — pill flotante (Fluid Island) ===== -->
    <header id="site-header" class="fixed top-0 inset-x-0 z-50 flex justify-center px-4 pt-4 sm:pt-6 transition-all duration-300">
      <nav id="nav-pill" class="w-full max-w-5xl flex items-center justify-between gap-3 pl-4 pr-2 sm:pl-6 sm:pr-2.5 h-14 rounded-full bg-white/80 backdrop-blur-xl border border-gray-100/80 shadow-[0_18px_40px_-24px_rgba(30,58,138,0.35)] transition-all duration-300">
        <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
          <img src="/logoOtto.png" alt="OTTO" width="763" height="327" class="h-7 w-auto transition-transform duration-300 group-hover:scale-105" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <span class="hidden items-center gap-1">
            <span class="text-xl font-extrabold text-gradient">otto</span>
          </span>
          <span class="text-[10px] text-gray-400 font-medium hidden md:block tracking-wide border-l border-gray-200 pl-2.5 leading-tight">Refuerzo escolar<br/>para chicos de 1° a 3°</span>
        </a>
        <div class="flex items-center gap-1 sm:gap-2 flex-shrink-0">
          <a href={WA_DUDAS}
            class="text-[13px] sm:text-sm font-medium text-gray-600 hover:text-[#0369A1] transition-colors px-2.5 sm:px-3.5 py-2.5 rounded-full hover:bg-gray-50 whitespace-nowrap">
            <span class="sm:hidden">Dudas</span>
            <span class="hidden sm:inline">¿Tenés dudas?</span>
          </a>
          <a href={APP_STORE} target="_blank" rel="noopener noreferrer"
            class="btn-primary group inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2.5 bg-[#0369A1] text-white text-[13px] sm:text-sm font-semibold rounded-full shadow-sm hover:shadow-lg hover:shadow-[#0369A1]/25 hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap">
            <span class="sm:hidden">Descargar</span>
            <span class="hidden sm:inline">Descargá la app</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 bounce-arrow flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <!-- ===== HERO — fondo oscuro, titular centrado, captura real de la app debajo ===== -->
    <section class="hero-dark relative overflow-hidden pt-28 pb-24 md:pt-32 md:pb-28">
      <!-- Patrón de puntos sutil -->
      <div class="absolute inset-0 dot-grid-light opacity-50 pointer-events-none"></div>
      <!-- Brillos de marca -->
      <div class="float-blob absolute top-0 right-0 w-[620px] h-[620px] bg-[#0ea5e9]/25 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4 pointer-events-none"></div>
      <div class="float-blob-slow absolute bottom-1/4 left-0 w-96 h-96 bg-[#1E3A8A]/30 rounded-full blur-3xl -translate-x-1/3 pointer-events-none"></div>

      <!-- Formas geométricas flotando -->
      <div class="float-shape absolute top-[18%] left-[8%] w-5 h-5 rounded-md bg-[#10B981]/70 rotate-12 pointer-events-none hidden sm:block"></div>
      <div class="float-shape-slow absolute top-[30%] right-[10%] w-7 h-7 rounded-full border-2 border-[#0ea5e9]/60 pointer-events-none hidden sm:block"></div>
      <div class="float-shape absolute top-[12%] right-[22%] w-3 h-3 rounded-full bg-[#fbbf24]/80 pointer-events-none hidden md:block" style="animation-delay:1.5s;"></div>
      <div class="float-shape-slow absolute bottom-[34%] left-[16%] w-4 h-4 rounded-sm bg-[#10B981]/60 rotate-45 pointer-events-none hidden md:block"></div>

      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <span class="fade-up inline-flex items-center gap-2 px-3.5 py-1.5 bg-white/10 backdrop-blur rounded-full border border-white/20 text-xs font-semibold text-white/90 mb-6 ring-1 ring-white/5">
          <span class="pulse-dot w-2 h-2 rounded-full bg-[#10B981] inline-block flex-shrink-0"></span>
          Ya disponible en el App Store · Muy pronto en Google Play
        </span>

        <h1 class="fade-up delay-1 text-[clamp(2rem,1.3rem+3vw,3.4rem)] font-extrabold text-white leading-[1.08] tracking-tight mb-5">
          La app con la que tus hijos
          <span class="relative inline-block">
            <span class="bg-gradient-to-r from-[#7dd3fc] via-[#38bdf8] to-[#6ee7b7] bg-clip-text text-transparent">repasan la escuela jugando</span>
          </span>
        </h1>

        <p class="fade-up delay-2 text-[clamp(1rem,0.9rem+0.5vw,1.2rem)] text-blue-100/90 leading-relaxed max-w-2xl mx-auto mb-8">
          Lectura, escritura y matemática para chicos de <span class="font-semibold text-white">1° a 3° grado</span>, con el mismo contenido que ven en la escuela. Cada chico cría su propio búho, gana cristales y sube de nivel mientras practica — sin publicidad y sin que tengas que sentarte al lado.
        </p>

        <div class="fade-up delay-3 flex flex-col sm:flex-row gap-3 justify-center items-center mb-8">
          <a href={APP_STORE} target="_blank" rel="noopener noreferrer"
            class="btn-primary group flex items-center justify-center gap-3 px-7 py-3.5 bg-white text-[#1E3A8A] font-bold rounded-full shadow-2xl shadow-black/20 hover:scale-[1.03] hover:-translate-y-0.5 transition-all duration-300 text-base">
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            <span class="text-left leading-tight">
              <span class="block text-[10px] font-semibold uppercase tracking-wide opacity-70">Descargala gratis en el</span>
              <span class="block text-base -mt-0.5">App Store</span>
            </span>
          </a>
