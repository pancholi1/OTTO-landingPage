---
import '../styles/global.css';

// Landing institucional (B2B): solo informativa, dirigida a directivos y docentes.
// Sin links de descarga ni de compra — el único acceso es el login del panel docente.
const MAIL = "mailto:contacto@ottoedu.com.ar";
const WA = "https://wa.me/5493329325672";
const LOGIN = "https://app.ottoedu.com.ar/login";

const APORTES = [
  { t: "Mayor atención y participación", d: "Los desafíos y las dinámicas de juego favorecen el interés y la participación activa de los chicos." },
  { t: "Los mismos contenidos, otra puerta de entrada", d: "No cambia lo que se enseña: cambia la forma en que el alumno se acerca a eso." },
  { t: "Aprender haciendo", d: "El alumno resuelve, se equivoca, recibe una devolución y vuelve a intentarlo. El error se convierte en una oportunidad para aprender, no en un motivo de frustración.", demo: true },
  { t: "Acompaña al docente, no lo reemplaza", d: "Complementa las propuestas del aula con secuencias didácticas ya planificadas, que permiten reforzar contenidos y acompañar a cada estudiante según su ritmo." },
  { t: "Sostiene la continuidad pedagógica", d: "Si un alumno no puede asistir a la escuela, puede seguir trabajando y mantener el vínculo con lo que se está viendo en clase." },
  { t: "Fortalece las trayectorias educativas", d: "Permite practicar, recuperar saberes y avanzar respetando los distintos ritmos de aprendizaje dentro de un mismo grupo." },
  { t: "Tecnología con sentido pedagógico", d: "No se trata de sumar tecnología porque está de moda, sino de usarla como una herramienta concreta para ampliar las oportunidades de aprender, en línea con el Diseño Curricular y las políticas educativas vigentes." },
  { t: "Optimiza el tiempo del docente", d: "El panel de gestión permite seguir el proceso de cada alumno y mantener una comunicación clara con las familias, dentro y fuera del aula." },
];

const AREAS = [
  { name: "Prácticas del Lenguaje", note: "Incluye un módulo de lectoescritura: letras, sílabas, palabras y lectura de textos." },
  { name: "Matemática", note: "Números, operaciones y resolución de problemas." },
  { name: "Ciencias Naturales", note: "Los seres vivos, el cuerpo y el ambiente." },
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "OTTO",
  "url": "https://www.ottoedu.com.ar/",
  "logo": "https://www.ottoedu.com.ar/logoOtto.png",
  "email": "contacto@ottoedu.com.ar",
  "telephone": "+5493329325672",
  "sameAs": ["https://www.instagram.com/ottoeduca/"],
  "description": "Plataforma educativa para escuelas, alineada al Diseño Curricular de la Provincia de Buenos Aires para primer ciclo (1°, 2° y 3° grado).",
  "areaServed": { "@type": "AdministrativeArea", "name": "Provincia de Buenos Aires, Argentina" },
};

const DESC = "Plataforma educativa para escuelas, alineada al Diseño Curricular de la Provincia de Buenos Aires para primer ciclo. Actividades interactivas por grado y por materia, y un panel para que el docente siga el proceso de cada alumno.";
---

<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/pet.png" />
    <link rel="apple-touch-icon" href="/pet.png" />
    <meta name="theme-color" content="#14215c" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>OTTO — Plataforma educativa para primer ciclo</title>
    <meta name="description" content={DESC} />
    <link rel="canonical" href="https://www.ottoedu.com.ar/" />
    <meta property="og:title" content="OTTO — Los mismos contenidos, otra puerta de entrada" />
    <meta property="og:description" content={DESC} />
    <meta property="og:image" content="https://www.ottoedu.com.ar/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content="https://www.ottoedu.com.ar/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="OTTO — Plataforma educativa para primer ciclo" />
    <meta name="twitter:description" content={DESC} />
    <meta name="twitter:image" content="https://www.ottoedu.com.ar/og-image.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,500;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Playpen+Sans:wght@500;700&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <style is:global>
      :root {
        --ink: #14215c;        /* azul tinta (marca) */
        --ink-soft: #46507a;
        --blue: #0369a1;       /* azul OTTO */
        --paper: #f7f9fc;      /* hoja */
        --rule: #d5e3f1;       /* renglón */
        --margin: #e0525c;     /* margen rojo del cuaderno / birome roja */
        --marker: #ffe36e;     /* resaltador */
        --check: #0f9f76;
        --line: rgba(20, 33, 92, 0.12);
        --tape: rgba(255, 238, 186, 0.78);

        --f-display: "Bricolage Grotesque", ui-sans-serif, system-ui, sans-serif;
        --f-body: "Atkinson Hyperlegible Next", ui-sans-serif, system-ui, sans-serif;
        --f-hand: "Playpen Sans", "Comic Sans MS", cursive;

        --rule-gap: 34px;
        --gutter: clamp(16px, 4vw, 40px);
        --maxw: 1180px;
      }

      html { scroll-behavior: smooth; scroll-padding-top: 80px; }
      html, body { max-width: 100%; overflow-x: hidden; }
      body {
        margin: 0;
        background: #fff;
        color: var(--ink);
        font-family: var(--f-body);
        font-size: 1.0625rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      img { max-width: 100%; height: auto; display: block; }
      a { color: inherit; }
      :focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; border-radius: 6px; }

      .wrap { max-width: var(--maxw); margin: 0 auto; padding-inline: var(--gutter); }
      .display { font-family: var(--f-display); font-weight: 800; letter-spacing: -0.025em; line-height: 1.02; font-optical-sizing: auto; }
      .hand { font-family: var(--f-hand); font-weight: 500; }
      .kid { text-transform: uppercase; }
      .label {
        font-family: var(--f-body);
        font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--blue);
      }

      /* ---------- Hoja de cuaderno ---------- */
      .ruled {
        position: relative;
        background-color: var(--paper);
        background-image: repeating-linear-gradient(to bottom, transparent 0 calc(var(--rule-gap) - 1px), var(--rule) calc(var(--rule-gap) - 1px) var(--rule-gap));
      }
      .ruled::before {
        /* margen rojo doble */
        content: ""; position: absolute; top: 0; bottom: 0;
        left: max(calc((100vw - var(--maxw)) / 2 - 8px), 22px);
        width: 5px;
        border-left: 1.5px solid var(--margin);
        border-right: 1px solid color-mix(in srgb, var(--margin) 55%, transparent);
        opacity: 0.75;
        pointer-events: none;
      }
      @media (max-width: 720px) { .ruled::before { left: 8px; opacity: 0.55; } }

      /* ---------- Nav ---------- */
      .nav {
        position: sticky; top: 0; z-index: 50;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
      }
      .nav-in { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 64px; }
      .nav-logo img { height: 28px; width: auto; }
      .nav-links { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
      .nav-links a {
        text-decoration: none; font-size: 0.93rem; font-weight: 500; color: var(--ink-soft);
        padding: 8px 12px; border-radius: 8px; transition: color .2s, background-color .2s;
      }
      .nav-links a:hover { color: var(--ink); background: rgba(3, 105, 161, 0.07); }
      .nav-cta {
        text-decoration: none; font-size: 0.9rem; font-weight: 700;
        padding: 9px 16px; border-radius: 999px;
        border: 1.5px solid var(--ink); color: var(--ink);
        transition: background-color .2s, color .2s; white-space: nowrap;
      }
      .nav-cta:hover { background: var(--ink); color: #fff; }
      @media (max-width: 900px) { .nav-links { display: none; } }

      /* ---------- Hero ---------- */
      .hero { padding-block: calc(var(--rule-gap) * 1.5) calc(var(--rule-gap) * 3); overflow: hidden; }
      .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 56px; align-items: center; }
      @media (min-width: 1024px) { .hero-grid { grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr); gap: 64px; } }

      .hero-note {
        display: inline-flex; align-items: center; gap: 10px;
        color: var(--margin); font-size: 1.05rem; transform: rotate(-1.5deg); margin: 0 0 22px;
      }
      .hero-note svg { flex: none; }
      .hero h1 { font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4.3rem); margin: 0 0 28px; }
      .hl {
        background-image: linear-gradient(100deg, transparent 0 1%, var(--marker) 2% 97%, transparent 98%);
        background-repeat: no-repeat;
        background-size: 0% 46%;
        background-position: 0 86%;
        -webkit-box-decoration-break: clone; box-decoration-break: clone;
        padding-inline: 4px; margin-inline: -4px;
        animation: highlight 1.1s cubic-bezier(.65,.05,.25,1) .45s forwards;
      }
      @keyframes highlight { to { background-size: 100% 46%; } }

      .hero-lead { font-size: clamp(1.08rem, 1rem + 0.35vw, 1.25rem); color: var(--ink-soft); max-width: 36em; margin: 0 0 34px; }
      .hero-lead strong { color: var(--ink); font-weight: 700; }

      .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin: 0; border-top: 1.5px solid var(--ink); max-width: 640px; }
      .facts > div { padding: 14px 18px 4px 0; }
      .facts > div + div { padding-left: 18px; border-left: 1px solid var(--line); }
      .facts dt { font-family: var(--f-display); font-weight: 700; font-size: 1.02rem; line-height: 1.2; margin-bottom: 4px; }
      .facts dd { margin: 0; font-size: 0.88rem; color: var(--ink-soft); line-height: 1.45; }
      @media (max-width: 640px) {
        .facts { grid-template-columns: 1fr; }
        .facts > div + div { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
        .facts > div { padding-bottom: 12px; }
      }

      .hero-down {
        display: inline-flex; align-items: center; gap: 8px; margin-top: 30px;
        font-weight: 700; text-decoration: none; color: var(--blue);
      }
      .hero-down svg { transition: transform .25s; }
      .hero-down:hover svg { transform: translateY(3px); }

      /* Captura "pegada" en el cuaderno */
      .pasted { position: relative; padding: 10px; background: #fff; box-shadow: 0 1px 0 var(--line), 0 30px 60px -30px rgba(20,33,92,.45), 0 8px 20px -12px rgba(20,33,92,.25); }
      .pasted.tilt-l { transform: rotate(-1.6deg); }
      .pasted.tilt-r { transform: rotate(1.4deg); }
      .pasted img { background: linear-gradient(160deg, #eef4fb, #f9fbfe); }
      .tape { position: absolute; width: 112px; height: 30px; background: var(--tape); box-shadow: 0 1px 2px rgba(0,0,0,.06); mix-blend-mode: multiply; }
      .tape::before, .tape::after { content: ""; position: absolute; top: 0; bottom: 0; width: 6px; background: inherit; }
      .tape.tl { top: -14px; left: -24px; transform: rotate(-32deg); }
      .tape.tr { top: -12px; right: -26px; transform: rotate(28deg); }
      .tape.bc { bottom: -14px; left: 50%; transform: translateX(-50%) rotate(-3deg); }

      .hero-figure { position: relative; }
      .hero-figure .owl { position: absolute; width: 92px; right: -6px; bottom: -58px; z-index: 2; filter: drop-shadow(0 12px 18px rgba(20,33,92,.25)); }
      .margin-note {
        position: absolute; color: var(--margin); font-size: 1rem; line-height: 1.25;
        display: flex; align-items: flex-end; gap: 6px;
      }
      .hero-figure .margin-note { left: 6px; bottom: -64px; transform: rotate(-3deg); }
      @media (max-width: 640px) {
        .hero-figure .owl { width: 70px; bottom: -48px; }
        .hero-figure .margin-note { font-size: .92rem; bottom: -58px; }
        .tape { width: 80px; height: 24px; }
      }

      /* ---------- Secciones ---------- */
      section { position: relative; }
      .sec { padding-block: clamp(72px, 9vw, 128px); }
      .sec-head { max-width: 760px; margin-bottom: clamp(36px, 5vw, 56px); }
      .sec-head h2 { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.15rem); margin: 12px 0 18px; }
      .sec-head p { color: var(--ink-soft); margin: 0; max-width: 40em; }

      /* Por qué */
      .why-grid { display: grid; gap: 40px; }
      @media (min-width: 960px) { .why-grid { grid-template-columns: 5fr 6fr; gap: 80px; align-items: start; } }
      .why-quote {
        font-family: var(--f-display); font-weight: 700; letter-spacing: -0.02em; line-height: 1.12;
        font-size: clamp(1.9rem, 1.3rem + 2.2vw, 2.9rem); margin: 14px 0 0;
      }
      .why-quote em { font-style: normal; color: var(--blue); }
      .why-body p { margin: 0 0 1.1em; color: var(--ink-soft); }
      .why-body p:first-child { color: var(--ink); font-size: 1.15rem; }
      .why-body strong { color: var(--ink); }

      /* Diseño Curricular */
      .cur-grid { display: grid; gap: 48px; }
      @media (min-width: 1000px) { .cur-grid { grid-template-columns: minmax(0, 1fr) 300px; gap: 72px; align-items: center; } }
      .plan { width: 100%; border-collapse: collapse; background: #fff; border: 1.5px solid var(--ink); font-size: .98rem; }
      .plan th, .plan td { padding: 18px 16px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
      .plan thead th { font-family: var(--f-display); font-weight: 700; font-size: 1rem; border-bottom: 1.5px solid var(--ink); background: var(--paper); }
      .plan thead th:not(:first-child) { text-align: center; width: 13%; }
      .plan tbody th { font-weight: 700; }
      .plan tbody th span { display: block; font-weight: 400; font-size: .86rem; color: var(--ink-soft); margin-top: 4px; line-height: 1.45; }
      .plan td { text-align: center; vertical-align: middle; }
      .plan td svg { margin: 0 auto; }
      .plan tbody tr:last-child > * { border-bottom: 0; }
      .plan caption { caption-side: bottom; text-align: left; padding-top: 14px; font-size: .88rem; color: var(--ink-soft); }
      .plan-wrap { overflow-x: auto; }
      @media (max-width: 560px) {
        .plan th, .plan td { padding: 14px 10px; }
        .plan thead th:not(:first-child) { width: 16%; }
      }

      .cur-points { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
      .cur-points li { padding: 14px 0; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 20px 1fr; gap: 12px; }
      .cur-points li svg { margin-top: 4px; }

      /* Sello */
      .stamp-box { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
      .stamp { width: 210px; height: 210px; color: var(--margin); transform: rotate(-9deg); opacity: .92; }
      .stamp-box p { margin: 0; font-size: .98rem; color: var(--ink-soft); max-width: 300px; }
      .stamp-box strong { color: var(--ink); display: block; font-family: var(--f-display); font-size: 1.15rem; margin-bottom: 2px; }

      /* Qué aporta — banda tinta */
      .ink-band { background: var(--ink); color: #eef3ff; }
      .ink-band .label { color: #8fd3ff; }
      .ink-band .sec-head p { color: #b9c5ea; }
      .aporta-grid { display: grid; gap: 56px; }
      @media (min-width: 1024px) { .aporta-grid { grid-template-columns: 420px minmax(0, 1fr); gap: 80px; align-items: start; } .aporta-side { position: sticky; top: 104px; } }
      .aporta-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1px solid rgba(255,255,255,.16); }
      @media (min-width: 680px) { .aporta-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; } }
      .aporta-list li { padding: 26px 0 28px; border-bottom: 1px solid rgba(255,255,255,.16); }
      .aporta-list h3 { font-family: var(--f-display); font-weight: 700; font-size: 1.22rem; letter-spacing: -0.01em; line-height: 1.2; margin: 0 0 8px; color: #fff; display: flex; gap: 10px; align-items: baseline; }
      .aporta-list h3 svg { flex: none; transform: translateY(2px); }
      .aporta-list p { margin: 0; color: #b9c5ea; font-size: .98rem; }
      .aporta-list .try { display: inline-block; margin-top: 10px; color: var(--marker); font-size: .95rem; }

      /* Demo de actividad */
      .demo {
        background: #fff; color: var(--ink); border-radius: 20px; padding: 22px 22px 24px;
        box-shadow: 0 30px 60px -28px rgba(0,0,0,.55);
      }
      .demo-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 18px; font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); }
      .demo-top img { width: 34px; height: 34px; object-fit: contain; }
      .demo-q { font-family: var(--f-display); font-weight: 800; font-size: 2rem; letter-spacing: -0.01em; margin: 0 0 18px; text-align: center; }
      .demo-opts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
      .demo-opt {
        font: 800 1.6rem/1 var(--f-display); color: var(--ink);
        padding: 18px 0; border-radius: 14px; cursor: pointer;
        background: var(--paper); border: 2px solid var(--rule);
        box-shadow: 0 4px 0 var(--rule);
        transition: transform .12s, box-shadow .12s, background-color .2s, border-color .2s;
      }
      .demo-opt:hover:not(:disabled) { border-color: var(--blue); box-shadow: 0 4px 0 var(--blue); }
      .demo-opt:active:not(:disabled) { transform: translateY(3px); box-shadow: 0 1px 0 var(--blue); }
      .demo-opt:disabled { cursor: default; }
      .demo-opt.is-wrong { background: #fdecee; border-color: var(--margin); box-shadow: 0 4px 0 var(--margin); color: var(--margin); animation: shake .4s; }
      .demo-opt.is-right { background: #e3f7ef; border-color: var(--check); box-shadow: 0 4px 0 var(--check); color: var(--check); }
      @keyframes shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }
      .demo-fb { min-height: 3.1em; margin: 16px 0 0; text-align: center; font-family: var(--f-hand); font-weight: 700; font-size: 1rem; line-height: 1.35; }
      .demo-fb.wrong { color: var(--margin); }
      .demo-fb.right { color: var(--check); }
      .demo-retry {
        display: block; margin: 6px auto 0; font: 700 .85rem var(--f-body); letter-spacing: .06em;
        background: var(--ink); color: #fff; border: 0; border-radius: 999px; padding: 10px 18px; cursor: pointer;
      }
      .demo-retry[hidden] { display: none; }
      .demo-cap { margin: 16px 2px 0; font-size: .9rem; color: #b9c5ea; }

      /* Docentes */
      .doc-grid { display: grid; gap: 56px; }
      @media (min-width: 1000px) { .doc-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 80px; align-items: center; } }
      .doc-points { list-style: none; margin: 0; padding: 0; display: grid; gap: 26px; }
      .doc-points h3 { font-family: var(--f-display); font-weight: 700; font-size: 1.22rem; margin: 0 0 6px; letter-spacing: -0.01em; }
      .doc-points p { margin: 0; color: var(--ink-soft); }
      .doc-points li { padding-left: 22px; border-left: 3px solid var(--rule); }
      .doc-points li:hover { border-left-color: var(--blue); }

      .panel { background: #fff; border: 1.5px solid var(--ink); border-radius: 18px; overflow: hidden; box-shadow: 12px 12px 0 var(--rule); }
      .panel-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 18px; border-bottom: 1px solid var(--line); background: var(--paper); }
      .panel-bar b { font-family: var(--f-display); font-size: 1.02rem; }
      .panel-bar span { font-size: .8rem; color: var(--ink-soft); }
      .panel-row { display: grid; grid-template-columns: 34px minmax(0, 1fr) 46px; gap: 14px; align-items: center; padding: 14px 18px; border-bottom: 1px solid var(--line); }
      .panel-row:last-of-type { border-bottom: 0; }
      .av { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; font: 700 .8rem var(--f-body); color: #fff; }
      .panel-row .nm { font-weight: 700; font-size: .95rem; line-height: 1.2; }
      .bar { height: 8px; background: var(--paper); border: 1px solid var(--rule); border-radius: 99px; margin-top: 7px; overflow: hidden; }
      .bar i { display: block; height: 100%; border-radius: inherit; background: var(--blue); transform-origin: left; transform: scaleX(0); transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
      .panel.in .bar i { transform: scaleX(var(--p)); }
      .panel-row .pct { font-size: .85rem; font-weight: 700; text-align: right; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
      .panel-foot { margin: 14px 4px 0; font-size: .85rem; color: var(--ink-soft); }

      /* Chicos de hoy */
      .kids-grid { display: grid; gap: 64px; align-items: center; }
      @media (min-width: 1000px) { .kids-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 80px; } }
      .kids-text h2 { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.15rem); margin: 12px 0 22px; }
      .kids-text p { color: var(--ink-soft); margin: 0 0 1.1em; }
      .kids-text .closing { color: var(--ink); font-family: var(--f-display); font-weight: 700; font-size: 1.3rem; line-height: 1.3; letter-spacing: -0.01em; margin-top: 1.4em; }
      .owls { display: flex; justify-content: center; align-items: flex-end; gap: clamp(18px, 4vw, 40px); margin-top: 52px; }
      .owls img { width: clamp(64px, 9vw, 92px); animation: wobble 6s ease-in-out infinite; filter: drop-shadow(0 12px 14px rgba(20,33,92,.2)); }
      .owls img:nth-child(2) { animation-delay: .8s; width: clamp(76px, 11vw, 108px); }
      .owls img:nth-child(3) { animation-delay: 1.6s; }
      @keyframes wobble { 0%,100% { transform: rotate(0) translateY(0); } 30% { transform: rotate(-3deg) translateY(-6px); } 60% { transform: rotate(2.5deg) translateY(-2px); } }
      .kids-figure .margin-note { right: 4px; top: -46px; transform: rotate(2deg); }

      /* Footer */
      .foot { background: var(--ink); color: #c9d3f2; padding-block: 64px 32px; font-size: .95rem; }
      .foot-grid { display: grid; gap: 40px; }
      @media (min-width: 860px) { .foot-grid { grid-template-columns: 1.4fr 1fr 1fr; gap: 56px; } }
      .foot-brand img { height: 30px; width: auto; filter: brightness(0) invert(1); margin-bottom: 16px; }
      .foot p { margin: 0; max-width: 34em; }
      .foot h4 { font: 700 .78rem var(--f-body); letter-spacing: .12em; text-transform: uppercase; color: #8fd3ff; margin: 0 0 14px; }
      .foot ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
      .foot a { text-decoration: none; transition: color .2s; }
      .foot a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
      .foot-bottom { margin-top: 48px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.14); font-size: .85rem; color: #93a0cc; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; }

      /* Entradas al hacer scroll */
      .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); }
      .reveal.visible { opacity: 1; transform: none; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
        .reveal { opacity: 1; transform: none; }
      }
    </style>
  </head>
  <body>

    <!-- ===== NAV ===== -->
    <header class="nav">
      <div class="wrap nav-in">
        <a href="/" class="nav-logo" aria-label="OTTO, inicio">
          <img src="/logoOtto.png" alt="OTTO" width="763" height="327" />
        </a>
        <nav aria-label="Secciones">
          <ul class="nav-links">
            <li><a href="#por-que">La propuesta</a></li>
            <li><a href="#curricular">Diseño Curricular</a></li>
            <li><a href="#aporta">Qué aporta</a></li>
            <li><a href="#docentes">Para docentes</a></li>
          </ul>
        </nav>
        <a href={LOGIN} class="nav-cta">Acceso docentes</a>
      </div>
    </header>

    <main>
      <!-- ===== HERO — hoja de cuaderno ===== -->
      <section class="ruled hero">
        <div class="wrap hero-grid">
          <div>
            <p class="hero-note hand">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13.5 9.5 19 20 6"/></svg>
              Primer ciclo · 1°, 2° y 3° grado
            </p>
            <h1 class="display">Los mismos contenidos, <span class="hl">otra puerta de entrada.</span></h1>
            <p class="hero-lead">
              OTTO es una plataforma educativa <strong>alineada al Diseño Curricular de la Provincia de Buenos Aires</strong>. Los chicos aprenden, practican y refuerzan lo que se ve en el aula con actividades interactivas y lúdicas, y el docente acompaña el proceso de cada uno desde su panel.
            </p>
            <dl class="facts">
              <div><dt>Diseño Curricular PBA</dt><dd>Sigue las secuencias irrenunciables y el cronograma anual</dd></div>
              <div><dt>Por grado y materia</dt><dd>Organizado como se organiza la escuela</dd></div>
              <div><dt>Contenido avalado</dt><dd>Revisado por una inspectora de educación primaria</dd></div>
            </dl>
            <a href="#por-que" class="hero-down">
              Conocé la propuesta
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
            </a>
          </div>

          <figure class="hero-figure" style="margin:0;">
            <div class="pasted tilt-l">
              <span class="tape tl" aria-hidden="true"></span>
              <span class="tape tr" aria-hidden="true"></span>
              <img src="/app-home.png" alt="Pantalla de inicio de OTTO: las misiones del alumno, los cristales que ganó y su búho" width="1668" height="946" loading="eager" decoding="async" />
            </div>
            <img class="owl" src="/pet.png" alt="" width="479" height="521" aria-hidden="true" />
            <figcaption class="margin-note hand">
              <svg width="30" height="26" viewBox="0 0 30 26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 24C6 14 13 7 25 4"/><path d="M19 2.5 25.5 4 22.5 10"/></svg>
              Así lo ven los chicos
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- ===== POR QUÉ ===== -->
      <section id="por-que" class="sec">
        <div class="wrap why-grid">
          <div class="reveal">
            <p class="label">¿Por qué incorporar una aplicación educativa?</p>
            <p class="why-quote">Los chicos cambian, y también cambian <em>sus formas de aprender.</em></p>
          </div>
          <div class="why-body reveal">
            <p>Hoy nuestros estudiantes interactúan, exploran, juegan, resuelven desafíos y reciben información de maneras muy distintas a las de hace apenas una década.</p>
            <p>La escuela tiene el desafío de acompañar esos cambios sin perder de vista lo más importante: <strong>garantizar que todos aprendan.</strong></p>
            <p>OTTO propone potenciar los contenidos del Diseño Curricular de la Provincia de Buenos Aires a partir de experiencias interactivas y lúdicas, que permiten aprender, practicar y reforzar conocimientos de una manera cercana y significativa para los estudiantes.</p>
          </div>
        </div>
      </section>

      <!-- ===== DISEÑO CURRICULAR ===== -->
      <section id="curricular" class="sec" style="background:var(--paper);">
        <div class="wrap">
          <div class="sec-head reveal">
            <p class="label">Alineado al Diseño Curricular</p>
            <h2 class="display">Organizado como se organiza la escuela</h2>
            <p>Las actividades siguen las secuencias irrenunciables que establece la Provincia y respetan el cronograma anual, organizadas por grado y por materia.</p>
          </div>

          <div class="cur-grid">
            <div class="reveal">
              <div class="plan-wrap">
                <table class="plan">
                  <thead>
                    <tr><th scope="col">Área</th><th scope="col">1°</th><th scope="col">2°</th><th scope="col">3°</th></tr>
                  </thead>
                  <tbody>
                    {AREAS.map(({ name, note }) => (
                      <tr>
                        <th scope="row">{name}<span>{note}</span></th>
                        {[1, 2, 3].map(() => (
                          <td>
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--check)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Incluido"><path d="M4 13.5 9.5 19 20 6"/></svg>
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <ul class="cur-points">
                {[
                  "Secuencias irrenunciables establecidas por la Provincia",
                  "Respeta el cronograma anual: acompaña lo que se está viendo en clase",
                  "Contenidos organizados por grado y por materia",
                ].map((t) => (
                  <li>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13.5 9.5 19 20 6"/></svg>
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="stamp-box reveal">
              <svg class="stamp" viewBox="0 0 200 200" role="img" aria-label="Sello: contenido revisado y avalado">
                <defs><path id="ring" d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" /></defs>
                <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="3" />
                <circle cx="100" cy="100" r="86" fill="none" stroke="currentColor" stroke-width="1.2" />
                <circle cx="100" cy="100" r="56" fill="none" stroke="currentColor" stroke-width="1.2" />
                <text font-family="Atkinson Hyperlegible Next, sans-serif" font-weight="700" font-size="15.5" letter-spacing="3.2" fill="currentColor">
                  <textPath href="#ring" startOffset="0">CONTENIDO REVISADO Y AVALADO · PRIMER CICLO ·</textPath>
                </text>
                <path d="M78 101 94 117 124 84" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <p><strong>Contenido avalado</strong>Revisado y avalado por una inspectora de educación primaria.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== QUÉ APORTA ===== -->
      <section id="aporta" class="sec ink-band">
        <div class="wrap aporta-grid">
          <div class="aporta-side">
            <div class="sec-head reveal" style="margin-bottom:32px;">
              <p class="label">¿Qué aporta?</p>
              <h2 class="display">Una herramienta concreta para el aula</h2>
              <p>Probá cómo responde una actividad cuando el alumno se equivoca.</p>
            </div>

            <div class="demo reveal" data-demo>
              <div class="demo-top">
                <span>Ejemplo · Matemática 1°</span>
                <img src="/pet.png" alt="" width="479" height="521" aria-hidden="true" />
              </div>
              <p class="demo-q kid" id="demo-q">¿Cuánto es 7 + 5?</p>
              <div class="demo-opts" role="group" aria-labelledby="demo-q">
                <button type="button" class="demo-opt" data-v="11">11</button>
                <button type="button" class="demo-opt" data-v="12">12</button>
                <button type="button" class="demo-opt" data-v="13">13</button>
              </div>
              <p class="demo-fb kid" aria-live="polite"></p>
              <button type="button" class="demo-retry kid" hidden>Volver a intentar</button>
            </div>
            <p class="demo-cap">Ejemplo ilustrativo. En OTTO los textos para los chicos van en mayúscula, pensados para lectores iniciales.</p>
          </div>

          <ul class="aporta-list">
            {APORTES.map(({ t, d, demo }) => (
              <li class="reveal">
                <h3>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13.5 9.5 19 20 6"/></svg>
                  {t}
                </h3>
                <p>{d}</p>
                {demo && <span class="try hand">← es lo que ves en el ejemplo</span>}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ===== DOCENTES ===== -->
      <section id="docentes" class="sec">
        <div class="wrap doc-grid">
          <div>
            <div class="sec-head reveal" style="margin-bottom:36px;">
              <p class="label">Para docentes y directivos</p>
              <h2 class="display">Acompaña al docente, no lo reemplaza</h2>
              <p>La aplicación complementa las propuestas del aula. El docente sigue siendo quien enseña; OTTO le suma tiempo, información y nuevas formas de acompañar a cada estudiante.</p>
            </div>
            <ul class="doc-points">
              <li class="reveal"><h3>Secuencias ya planificadas</h3><p>Secuencias didácticas listas para reforzar los contenidos que se trabajan en clase.</p></li>
              <li class="reveal"><h3>Seguimiento de cada alumno</h3><p>El panel de gestión muestra el proceso de cada estudiante, para acompañarlo según su ritmo.</p></li>
              <li class="reveal"><h3>Comunicación con las familias</h3><p>Información clara para mantener a las familias al tanto, dentro y fuera del aula.</p></li>
              <li class="reveal"><h3>Continuidad pedagógica</h3><p>Si un alumno no puede asistir, sigue trabajando desde casa con lo que se está viendo en clase.</p></li>
            </ul>
          </div>

          <figure class="reveal" style="margin:0;">
            <div class="panel" data-panel>
              <div class="panel-bar"><b>2° grado · Matemática</b><span>Progreso de la secuencia</span></div>
              {[
                { n: "Sofía M.", p: 0.86, c: "#0369a1" },
                { n: "Benjamín R.", p: 0.64, c: "#0f9f76" },
                { n: "Valentina G.", p: 0.92, c: "#e0525c" },
                { n: "Thiago L.", p: 0.41, c: "#8c2ce6" },
                { n: "Martina P.", p: 0.73, c: "#d97706" },
              ].map(({ n, p, c }) => (
                <div class="panel-row">
                  <span class="av" style={`background:${c};`} aria-hidden="true">{n.split(" ").map((s) => s[0]).join("")}</span>
                  <div>
                    <div class="nm">{n}</div>
                    <div class="bar"><i style={`--p:${p};`}></i></div>
                  </div>
                  <span class="pct">{Math.round(p * 100)}%</span>
                </div>
              ))}
            </div>
            <figcaption class="panel-foot">Vista ilustrativa del seguimiento en el panel docente.</figcaption>
          </figure>
        </div>
      </section>

      <!-- ===== CHICOS DE HOY ===== -->
      <section class="ruled sec">
        <div class="wrap kids-grid">
          <div class="kids-text reveal">
            <p class="label">Una herramienta para los chicos de hoy</p>
            <h2 class="display">El cuaderno, el libro y el pizarrón no pierden su lugar</h2>
            <p>No se trata de reemplazar el cuaderno, el libro, el pizarrón ni la enseñanza del docente. Se trata de sumar otra manera de aprender, más cercana a las experiencias y a las formas de interacción de los estudiantes de hoy.</p>
            <p>Cada alumno cría su propio búho, que lo acompaña en cada actividad y crece a medida que practica. Es lo que hace que quieran volver.</p>
            <p class="closing">Si los chicos cambian su manera de aprender, la escuela también puede sumar herramientas que acompañen ese cambio.</p>
          </div>

          <figure class="kids-figure reveal" style="margin:0; position:relative;">
            <p class="margin-note hand" aria-hidden="true">Cada alumno, su búho</p>
            <div class="pasted tilt-r">
              <span class="tape bc" aria-hidden="true"></span>
              <img src="/app-onboarding.png" alt="Pantalla de OTTO donde nace el búho y el alumno le pone nombre" width="1668" height="946" loading="lazy" decoding="async" />
            </div>
            <div class="owls" aria-hidden="true">
              <img src="/buho-3.png" alt="" width="120" height="240" loading="lazy" decoding="async" />
              <img src="/buho-1.png" alt="" width="120" height="240" loading="lazy" decoding="async" />
              <img src="/buho-2.png" alt="" width="120" height="240" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
      </section>
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="foot">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-brand">
            <img src="/logoOtto.png" alt="OTTO" width="763" height="327" loading="lazy" />
            <p>Plataforma educativa alineada al Diseño Curricular de la Provincia de Buenos Aires para primer ciclo.</p>
          </div>
          <div>
            <h4>Contacto</h4>
            <ul>
              <li><a href={MAIL}>contacto@ottoedu.com.ar</a></li>
              <li><a href={WA} target="_blank" rel="noopener noreferrer">WhatsApp +54 9 3329 32-5672</a></li>
              <li><a href="https://www.instagram.com/ottoeduca/" target="_blank" rel="noopener noreferrer">Instagram @ottoeduca</a></li>
            </ul>
          </div>
          <div>
            <h4>Plataforma</h4>
            <ul>
              <li><a href={LOGIN}>Acceso docentes</a></li>
              <li><a href="/terminos">Términos y Condiciones</a></li>
              <li><a href="/privacidad">Política de Privacidad</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© 2026 OTTO. Todos los derechos reservados.</span>
          <span>Hecho en Argentina</span>
        </div>
      </div>
    </footer>

    <script>
      // Entradas al hacer scroll
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add(e.target.hasAttribute('data-panel') ? 'in' : 'visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15 });
      document.querySelectorAll('.reveal, [data-panel]').forEach((el) => io.observe(el));

      // Demo: resolver → equivocarse → devolución → volver a intentar
      const demo = document.querySelector<HTMLElement>('[data-demo]');
      if (demo) {
        const opts = Array.from(demo.querySelectorAll<HTMLButtonElement>('.demo-opt'));
        const fb = demo.querySelector<HTMLElement>('.demo-fb')!;
        const retry = demo.querySelector<HTMLButtonElement>('.demo-retry')!;
        const reset = () => {
          opts.forEach((b) => { b.disabled = false; b.classList.remove('is-wrong', 'is-right'); });
          fb.textContent = ''; fb.className = 'demo-fb kid';
          retry.hidden = true;
          opts[0].focus();
        };
        opts.forEach((b) => b.addEventListener('click', () => {
          const ok = b.dataset.v === '12';
          opts.forEach((o) => (o.disabled = true));
          b.classList.add(ok ? 'is-right' : 'is-wrong');
          fb.classList.add(ok ? 'right' : 'wrong');
          fb.textContent = ok
            ? '¡Muy bien! 7 + 5 = 12. Tu búho ganó un cristal.'
            : 'Casi. Contá desde el 7: 8, 9, 10, 11, 12…';
          retry.textContent = ok ? 'Jugar de nuevo' : 'Volver a intentar';
          retry.hidden = false;
          retry.focus();
        }));
        retry.addEventListener('click', reset);
      }
    </script>
  </body>
</html>
